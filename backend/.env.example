# =============================================================================
# Jivhala Wellness Center — Environment Configuration
# Copy this file to .env and update the values for your environment.
# =============================================================================

# Environment: "development" or "production"
ENVIRONMENT=development

# JWT Secret — Generate a strong random key for production
# Example: openssl rand -hex 32
SECRET_KEY=your-strong-random-secret-key-here

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/jivhala_wellness

# CORS Origins (JSON array format)
# In production, set this to your actual frontend domain
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# WhatsApp Bot API Key — shared secret between backend and bot
WHATSAPP_BOT_API_KEY=change-this-whatsapp-api-key-in-production
